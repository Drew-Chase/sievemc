{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sievemc",
  "version": "0.2.1",
  "identifier": "com.github.drewchase.sievemc",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sievemc",
        "minWidth": 880,
        "minHeight": 600,
        "height": 720,
        "width": 1280,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
